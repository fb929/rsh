#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import sys
# make the package next to this script win over any stale install (e.g. /opt/rsh),
# resolving symlinks so launching via a symlink in PATH still finds it
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
sys.path.append('/opt/rsh')
import argparse
import logging
import pexpect
import gnupg
import getpass
import struct
import signal
import fcntl
import termios
import re

import rsh.config
from rsh.inventory import load_inventory, resolve_ssh_host

logger = logging.getLogger('sr')

# parse args {{
parser = argparse.ArgumentParser()
parser.add_argument(
    'host',
    help = 'host for login',
)
group = parser.add_mutually_exclusive_group()
group.add_argument(
    '-i',
    '--forceUseInventory',
    action='store_true',
    help = "force use inventory",
)
group.add_argument(
    '-I',
    '--forceDontUseInventory',
    action='store_true',
    help = "force don't use inventory",
)
args = parser.parse_args()
# }}

# matches 'Password:' (su) and '[sudo] password for user:' (sudo)
passwordPromptRegex = r'[Pp]assword[^\r\n]*:'

# defs
def decryptFile(requestPass=False):
    if requestPass:
        password = getpass.getpass()
        if not password:
            logger.error("failed get pass")
            sys.exit(1)

    gpg = gnupg.GPG(use_agent=True)
    gpg.encoding = 'utf-8'

    with open(rsh.config.cfg['gpgFile'], 'rb') as cryptoInfile:
        try:
            if requestPass:
                decryptedData = gpg.decrypt_file(cryptoInfile,passphrase=password)
            else:
                decryptedData = gpg.decrypt_file(cryptoInfile)
        except Exception as e:
            logger.error("failed decrypt data, error: '%s'", str(e))
            sys.exit(1)

    if decryptedData:
        return str(decryptedData).rstrip()
    if requestPass:
        logger.error("'decryptedData' is empty, please check encrypt file='%s'", rsh.config.cfg['gpgFile'])
        sys.exit(1)
    # gpg-agent could not decrypt silently, retry asking for the passphrase
    return decryptFile(requestPass=True)

def getRootPassword(host):
    decryptedData = decryptFile()
    for lineNumber, line in enumerate(decryptedData.splitlines(), 1):
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        splitted = line.split('\t', 1)
        if len(splitted) != 2:
            logger.warning("skipping line %d of password file: expected '<host regex>\\t<password>'", lineNumber)
            continue
        hostRegex, rootPasswd = splitted
        if re.search(hostRegex, host, re.IGNORECASE):
            return rootPasswd

    logger.error("failed get root password for host='%s', please check password file='%s'", host,rsh.config.cfg['gpgFile'])
    sys.exit(1)

def getTerminalSize():
    s = struct.pack("HHHH", 0, 0, 0, 0)
    a = struct.unpack('hhhh', fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, s))
    return a[0], a[1]

def sigwinchPassthrough(sig, data):
    global child
    if not child.closed:
        child.setwinsize(*getTerminalSize())

def getEscalatePrivilegesCommands():
    """ return list of commands for escalate privileges, in order of trying
    'escalatePrivilegesCommands' (list) has priority,
    'escalatePrivilegesCommand' (string) kept for backward compatibility
    """
    commands = rsh.config.cfg['sr'].get('escalatePrivilegesCommands')
    if isinstance(commands, str):
        commands = [commands]
    if not commands:
        legacyCommand = rsh.config.cfg['sr'].get('escalatePrivilegesCommand')
        if not legacyCommand:
            logger.error("'sr.escalatePrivilegesCommands' is empty, nothing to try")
            sys.exit(1)
        commands = [legacyCommand]
    return [str(command) for command in commands if command]

def checkRootShell():
    """ check that current shell on host is root shell, returns True/False """
    global child
    timeout = rsh.config.cfg['sr']['pexpect']['timeout']
    marker = 'RSH_UID_'

    child.sendline('echo %s$(id -u)' % (marker))
    index = child.expect([
        marker + r'(\d+)\r\n',
        passwordPromptRegex,
        pexpect.TIMEOUT,
        pexpect.EOF,
    ], timeout=timeout)
    if index == 0:
        uid = int(child.match.group(1))
        logger.debug("uid='%s'", uid)
        return uid == 0
    if index == 1:
        # the host is still asking for a password (our probe was typed into the prompt), abort it
        logger.debug("unexpected password prompt, aborting")
        child.sendcontrol('c')
        child.expect('\r\n', timeout=timeout)
        return False
    logger.debug("no answer from host, index='%s'", index)
    return False

def escalatePrivileges(command):
    """ try to escalate privileges with the given command, returns True/False """
    global child, rootPassword
    timeout = rsh.config.cfg['sr']['pexpect']['timeout']

    child.sendline(command)
    index = child.expect([
        passwordPromptRegex,
        r'\r\n',
    ], timeout=timeout)
    if index == 0:
        print(child.before.rstrip())
        print(child.after.rstrip())
        if rootPassword is None:
            rootPassword = getRootPassword(host=args.host)
        child.sendline(rootPassword)
        child.expect('\r\n', timeout=timeout)
    return checkRootShell()

if __name__ == "__main__":
    rootPassword = None # requested lazily, only when the host asks for a password
    if args.forceUseInventory:
        rsh.config.cfg['sr']['useInventorySshHost'] = True
    if args.forceDontUseInventory:
        rsh.config.cfg['sr']['useInventorySshHost'] = False
    if rsh.config.cfg['sr']['useInventorySshHost']:
        inventory = load_inventory(rsh.config.cfg)
        sshHost = resolve_ssh_host(args.host, inventory, rsh.config.cfg['inventoryFilePath'])
    else:
        sshHost = args.host

    # connect to host {{
    child = pexpect.spawn('%s %s' % (rsh.config.cfg['sr']['ssh']['command'],sshHost), encoding='utf-8')
    child.setwinsize(*getTerminalSize())
    signal.signal(signal.SIGWINCH, sigwinchPassthrough)
    child.expect('\r\n', timeout=rsh.config.cfg['sr']['pexpect']['timeout'])
    print(child.before.rstrip())
    # }}

    # run post login command {{
    if rsh.config.cfg['sr']['postLoginCommand'] != None:
        child.sendline(rsh.config.cfg['sr']['postLoginCommand'])
        child.expect('\r\n', timeout=rsh.config.cfg['sr']['pexpect']['timeout'])
    # }}

    # escalate privileges {{
    escalated = False
    for escalateCommand in getEscalatePrivilegesCommands():
        logger.debug("trying escalate privileges with command='%s'", escalateCommand)
        if escalatePrivileges(escalateCommand):
            logger.debug("escalate privileges with command='%s' succeeded", escalateCommand)
            escalated = True
            break
        logger.warning("escalate privileges with command='%s' failed, trying next command", escalateCommand)
    if not escalated:
        logger.error("failed escalate privileges on host='%s', all commands failed: %s", args.host,getEscalatePrivilegesCommands())
        sys.exit(1)
    # }}

    # translation into interactive
    child.interact(escape_character=None)
