#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import sys
sys.path.append('/opt/rsh')
import rsh.config
import argparse
import pexpect
import gnupg
import getpass
import struct
import signal
import fcntl
import termios
import inspect
import re
import os
import yaml

# parse args {{
parser = argparse.ArgumentParser()
parser.add_argument(
    'host',
    help = 'host for login',
)
group = parser.add_mutually_exclusive_group()
group.add_argument(
    '-i',
    '--forceUseInventory',
    action='store_true',
    help = "force use inventory",
)
group.add_argument(
    '-I',
    '--forceDontUseInventory',
    action='store_true',
    help = "force don't use inventory",
)
args = parser.parse_args()
# }}

# matches 'Password:' (su) and '[sudo] password for user:' (sudo)
passwordPromptRegex = r'[Pp]assword[^\r\n]*:'

# defs
def decryptFile(requestPass=False):
    defName = inspect.stack()[0][3]

    if requestPass:
        password = getpass.getpass()
        if not password:
            rsh.config.logging.error("%s: failed get pass" % (defName))
            exit(1)

    gpg = gnupg.GPG(use_agent=True)
    gpg.encoding = 'utf-8'

    with open(rsh.config.cfg['gpgFile'], 'rb') as cryptoInfile:
        try:
            if requestPass:
                decryptedData = gpg.decrypt_file(cryptoInfile,passphrase=password)
            else:
                decryptedData = gpg.decrypt_file(cryptoInfile)
        except Exception as e:
            rsh.config.logging.error("%s: failed decrypt data, error: '%s'" % (defName,str(e)))
            exit(1)

    if decryptedData:
        return str(decryptedData).rstrip()
    else:
        if requestPass:
            rsh.config.logging.error("%s: 'decryptedData' is empty, please check encrypt file='%s'" % (defName,rsh.config.cfg['gpgFile']))
            exit(1)
        else:
            # retry with request password
            decryptFile(requestPass=True)

def getRootPassword(host):
    defName = inspect.stack()[0][3]

    decryptedData = decryptFile()
    for line in decryptedData.splitlines():
        splitted = line.split('\t')
        hostRegex = splitted[0]
        rootPasswd = splitted[1]
        if re.search(r''+hostRegex, host, re.IGNORECASE):
            return rootPasswd

    rsh.config.logging.error("%s: failed get root password for host='%s', please check password file='%s'" % (defName,host,rsh.config.cfg['gpgFile']))
    exit(1)

def getTerminalSize():
    s = struct.pack("HHHH", 0, 0, 0, 0)
    a = struct.unpack('hhhh', fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, s))
    return a[0], a[1]

def sigwinchPassthrough(sig, data):
    global child
    if not child.closed:
        child.setwinsize(*getTerminalSize())

def getEscalatePrivilegesCommands():
    """ return list of commands for escalate privileges, in order of trying
    'escalatePrivilegesCommands' (list) has priority,
    'escalatePrivilegesCommand' (string) kept for backward compatibility
    """
    defName = inspect.stack()[0][3]

    commands = rsh.config.cfg['sr'].get('escalatePrivilegesCommands')
    if isinstance(commands, str):
        commands = [commands]
    if not commands:
        legacyCommand = rsh.config.cfg['sr'].get('escalatePrivilegesCommand')
        if not legacyCommand:
            rsh.config.logging.error("%s: 'sr.escalatePrivilegesCommands' is empty, nothing to try" % (defName))
            exit(1)
        commands = [legacyCommand]
    return [str(command) for command in commands if command]

def checkRootShell():
    """ check that current shell on host is root shell, returns True/False """
    global child
    defName = inspect.stack()[0][3]
    timeout = rsh.config.cfg['sr']['pexpect']['timeout']
    marker = 'RSH_UID_'

    child.sendline('echo %s$(id -u)' % (marker))
    index = child.expect([
        marker + r'(\d+)\r\n',
        passwordPromptRegex,
        pexpect.TIMEOUT,
        pexpect.EOF,
    ], timeout=timeout)
    if index == 0:
        uid = int(child.match.group(1))
        rsh.config.logging.debug("%s: uid='%s'" % (defName,uid))
        return uid == 0
    if index == 1:
        # the host is still asking for a password (our probe was typed into the prompt), abort it
        rsh.config.logging.debug("%s: unexpected password prompt, aborting" % (defName))
        child.sendcontrol('c')
        child.expect('\r\n', timeout=timeout)
        return False
    rsh.config.logging.debug("%s: no answer from host, index='%s'" % (defName,index))
    return False

def escalatePrivileges(command):
    """ try to escalate privileges with the given command, returns True/False """
    global child, rootPassword
    defName = inspect.stack()[0][3]
    timeout = rsh.config.cfg['sr']['pexpect']['timeout']

    child.sendline(command)
    index = child.expect([
        passwordPromptRegex,
        r'\r\n',
    ], timeout=timeout)
    if index == 0:
        print(child.before.rstrip())
        print(child.after.rstrip())
        if rootPassword is None:
            rootPassword = getRootPassword(host=args.host)
        child.sendline(rootPassword)
        child.expect('\r\n', timeout=timeout)
    return checkRootShell()

if __name__ == "__main__":
    defName = "sr"
    rootPassword = None # requested lazily, only when the host asks for a password
    if args.forceUseInventory:
        rsh.config.cfg['sr']['useInventorySshHost'] = True
    if args.forceDontUseInventory:
        rsh.config.cfg['sr']['useInventorySshHost'] = False
    if rsh.config.cfg['sr']['useInventorySshHost']:
        inventory = dict()
        try:
            with open(os.path.expanduser(rsh.config.cfg['inventoryFilePath']), 'r') as ymlfile:
                inventory.update(yaml.load(ymlfile,Loader=yaml.Loader))
        except Exception as e:
            rsh.config.logging.error("%s: failed inventory from file: '%s', error: '%s'" % (defName,rsh.config.cfg['inventoryFilePath'],e))
            exit(1)
        inventoryHost = inventory['hosts'].get(args.host, None)
        if inventoryHost:
            sshHost = inventory['hosts'][args.host].get('sshHost', None)
        else:
            rsh.config.logging.warning("%s: host='%s' not found in inventory file='%s'" % (defName,args.host,rsh.config.cfg['inventoryFilePath']))
            sshHost = args.host
        if sshHost == None:
            rsh.config.logging.error("%s: unexpected error 'sshHost'='%s'" % (defName,sshHost))
            exit(1)
    else:
        sshHost = args.host

    # connect to host {{
    child = pexpect.spawn('%s %s' % (rsh.config.cfg['sr']['ssh']['command'],sshHost), encoding='utf-8')
    child.setwinsize(*getTerminalSize())
    signal.signal(signal.SIGWINCH, sigwinchPassthrough)
    child.expect('\r\n', timeout=rsh.config.cfg['sr']['pexpect']['timeout'])
    print(child.before.rstrip())
    # }}

    # run post login command {{
    if rsh.config.cfg['sr']['postLoginCommand'] != None:
        child.sendline(rsh.config.cfg['sr']['postLoginCommand'])
        child.expect('\r\n', timeout=rsh.config.cfg['sr']['pexpect']['timeout'])
    # }}

    # escalate privileges {{
    escalated = False
    for escalateCommand in getEscalatePrivilegesCommands():
        rsh.config.logging.debug("%s: trying escalate privileges with command='%s'" % (defName,escalateCommand))
        if escalatePrivileges(escalateCommand):
            rsh.config.logging.debug("%s: escalate privileges with command='%s' succeeded" % (defName,escalateCommand))
            escalated = True
            break
        rsh.config.logging.warning("%s: escalate privileges with command='%s' failed, trying next command" % (defName,escalateCommand))
    if not escalated:
        rsh.config.logging.error("%s: failed escalate privileges on host='%s', all commands failed: %s" % (defName,args.host,getEscalatePrivilegesCommands()))
        exit(1)
    # }}

    # translation into interactive
    child.interact(escape_character=None)
